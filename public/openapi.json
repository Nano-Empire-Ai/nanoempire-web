    "/api/v1/match": {
      "servers": [
        {
          "url": "https://recallguard-api.vercel.app",
          "description": "PRIMARY RecallGuard server. HTTPS, open access (no paywall enforced as of 2026-09-27), 21,812 recalls (CPSC + openFDA food/drug/device, 2023-01-04 to 2026-09-24). Endpoints under /api/v1. Human docs: /docs."
        }
      ],
      "post": {
        "operationId": "rgMatch",
        "summary": "RecallGuard match, primary server (body key: items)",
        "description": "Per item: UPC exact match first (GTIN-normalized), then token-overlap scoring on name/brand. Token matches below the score threshold are not returned. Up to 5 matches per item.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "items"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "examples": [
                            "Snuga Swing"
                          ]
                        },
                        "brand": {
                          "type": "string",
                          "examples": [
                            "Fisher-Price"
                          ]
                        },
                        "upc": {
                          "type": "string",
                          "examples": [
                            "731149654051"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "items": [
                  {
                    "name": "Snuga Swing",
                    "brand": "Fisher-Price"
                  },
                  {
                    "name": "Raw Shrimp",
                    "upc": "731149654051"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "input": {
                            "type": "object"
                          },
                          "match_count": {
                            "type": "integer"
                          },
                          "matches": {
                            "type": "array",
                            "items": {
                              "$ref": "#/components/schemas/VercelMatch"
                            }
                          }
                        }
                      }
                    },
                    "threshold": {
                      "type": "number"
                    },
                    "dataset_built_at": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VercelError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VercelError"
                }
              }
            }
          },
          "413": {
            "description": "Too many items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VercelError"
                }
              }
            }
          }
        },
        "tags": [
          "RecallGuard"
        ],
