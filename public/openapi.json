    "/api/v1/feed": {
      "servers": [
        {
          "url": "https://recallguard-api.vercel.app",
          "description": "PRIMARY RecallGuard server. HTTPS, open access (no paywall enforced as of 2026-09-27), 21,812 recalls (CPSC + openFDA food/drug/device, 2023-01-04 to 2026-09-24). Endpoints under /api/v1. Human docs: /docs."
        }
      ],
      "get": {
        "operationId": "rgFeed",
        "summary": "RecallGuard feed, primary server (paginated, newest first)",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Only recalls with recall_date >= since (YYYY-MM-DD)."
          },
          {
            "name": "until",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Only recalls with recall_date <= until (YYYY-MM-DD)."
          },
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated: cpsc, fda-food, fda-drug, fda-device."
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated: serious, standard, class-i, class-ii, class-iii (also accepts \"Class I\" etc.)."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Opaque cursor from next_cursor of the previous page."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/VercelRecall"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "dataset_built_at": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VercelError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VercelError"
                }
              }
            }
          }
        },
        "tags": [
          "RecallGuard"
        ],
        "security": [],
        "x-price": {
          "sku": "recallguard-feed",
          "amount": "0.05",
          "asset": "USDC",
